DISCORD_TOKEN=put-your-bot-token-here
# Optional: limit slash-command sync to one guild for instant updates
# GUILD_ID=123456789012345678
STAFF_ROLE_NAME=Support
SENIOR_STAFF_ROLE_NAME=Senior Support
SUPPORT_CATEGORY_NAME=SUPPORT
TICKETS_CATEGORY_NAME=Tickets
REPORT_CHANNEL_NAME=report-a-problem
LOG_CHANNEL_NAME=support-log
SENIOR_LOG_CHANNEL_NAME=senior-log
BANNED_ROLE_NAME=Banned
APPEAL_CHANNEL_NAME=appeal
RECOMMEND_CHANNEL_NAME=recommend-senior
NOTES_LOG_CHANNEL_NAME=staff-notes
ACTIONS_LOG_CHANNEL_NAME=mod-actions
MESSAGE_LOG_CHANNEL_NAME=message-log
IDLE_WARN_HOURS=24
IDLE_CLOSE_HOURS=72
IDLE_CHECK_MINUTES=15

# Security / Anti-spam
SECURITY_ENABLED=true
SPAM_WINDOW_SEC=10
SPAM_MAX_MESSAGES=5
SPAM_MAX_MENTIONS=5
SPAM_MAX_LINKS=3
SPAM_DUPLICATE_WINDOW_SEC=30
LINK_BLOCK_SHORTENERS=true
LINK_BLOCK_SUSPICIOUS_TLDS=true
SECURITY_LOG_CHANNEL_NAME=security-log
SECURITY_ACTION_DURATION_MIN=10
